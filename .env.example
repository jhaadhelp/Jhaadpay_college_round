# No API key is required. The first semantic audit downloads the pinned model.
PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
MODEL_CACHE_DIR=./.cache/models
# Set a strong password before exposing the server beyond localhost.
APP_PASSWORD=
# Set 1 when serving over HTTPS behind a reverse proxy.
SECURE_COOKIE=0
# Optional exact external origin behind a reverse proxy (e.g. https://audit.example.com).
# Codespaces private port origins are detected automatically.
PUBLIC_ORIGIN=

# Individual accounts are required, including localhost. No shared password.
PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
MODEL_CACHE_DIR=./.cache/models
# Local Google redirect: http://127.0.0.1:3001/api/auth/google/callback
# On public hosting, use the exact HTTPS origin (no trailing slash).
PUBLIC_ORIGIN=http://127.0.0.1:3001
# Set 1 on HTTPS hosting. Local HTTP development uses 0.
SECURE_COOKIE=0
# Google Cloud OAuth web application credentials. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional comma-separated trusted reverse proxy IPs/CIDRs, supplied by host.
# Do not use arbitrary forwarded headers or trust all proxies.
TRUST_PROXY=
